# build output
dist/
.cache
# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# Astro
.astro/

# upwise 로고 원본 파일 (배포에 불필요 — public/ 에 변환본만 사용)
_upwise/

# 로컬 참고 자료 (Notion export 원본 + 구축 history). 빌드/배포와 무관.
_reference/

# Temp files from image optimization (in case of file-lock failure on Windows)
public/**/*.tmp
*.tmp
# Microsoft Office lock/temp files
~$*

# CV scratch screenshots (underscore-prefixed)
cv/_*.png

# Publication figure inbox — 원본 고해상도(로컬 전용). 최적화본만 public/papers/figures/ 에 커밋.
_figures_inbox/

# 개인용 지원서 정보(비공개)
cv/application_info.xlsx
cv/old/논문실적_지원용.xlsx
cv/old/국가rnd정보.xlsx
cv/_csv/
cv/old/application_info_v*.xlsx
cv/old/application_info_backup_*.xlsx

# Python 캐시
__pycache__/
*.pyc

# 서명 이미지 — 신원 자격증명. 저장소에 절대 커밋하지 않는다 (비공개 %USERPROFILE%\.config\gugi516\ 보관)
cv/signature.png
cv/assets/signature.png
cv/old/signature_original_2021.png
cv/**/*signature*.png
cv/pys_old/

# 스크립트 실행 로그 (로컬 보관 — 공개 저장소에 올리지 않는다)
cv/_logs/
_logs/

