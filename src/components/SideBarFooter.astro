---
import site from "../data/site.json";
const c = site.contact;
---

<div class="block sticky pointer-events-none bottom-10 bg-base-200 justify-center h-12 [mask-image:linear-gradient(transparent,#000000)]"></div>

<div class="social-icons px-3 pb-5 pt-1 flex flex-wrap items-center self-center justify-center sticky bottom-0 bg-base-200 gap-1">
  <!-- Email -->
  <a href={`mailto:${c.email}`} class="icon-btn" aria-label="Email" title={c.email}>
    <svg xmlns="http://www.w3.org/2000/svg" width="19.8" height="19.8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
      <polyline points="22,6 12,13 2,6"></polyline>
    </svg>
  </a>

  <!-- Google Scholar -->
  {c.scholarUrl && (
    <a href={c.scholarUrl} target="_blank" rel="noopener noreferrer" class="icon-btn" aria-label="Google Scholar" title="Google Scholar">
      <svg xmlns="http://www.w3.org/2000/svg" width="22.5" height="22.5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 14l-9-5.4L12 3l9 5.6L12 14zm0 1.1l-7-4.2v3.3c0 2.8 3.1 5.1 7 5.1s7-2.3 7-5.1v-3.3l-7 4.2z"/></svg>
    </a>
  )}

  <!-- ORCID -->
  {c.orcidUrl && (
    <a href={c.orcidUrl} target="_blank" rel="noopener noreferrer" class="icon-btn" aria-label="ORCID" title="ORCID">
      <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24"><mask id="orcid-id-f" maskUnits="userSpaceOnUse"><rect width="24" height="24" fill="#fff"/><g fill="#000" stroke="#000" stroke-width="0.43" stroke-linejoin="round"><path d="M7.369 4.378c.525 0 .947.431.947.947 0 .525-.422.947-.947.947-.525 0-.946-.422-.946-.947 0-.516.421-.947.946-.947z"/><path d="M6.647 7.416h1.444v10.041H6.647V7.416z"/><path d="M10.209 7.416h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.025-5.325 5.025h-3.919V7.416z"/></g><path d="M11.653 8.719v7.444h2.297c2.359 0 3.588-1.444 3.588-3.722 0-2.016-1.091-3.722-3.722-3.722h-2.163z" fill="#fff"/></mask><circle cx="12" cy="12" r="12" fill="currentColor" mask="url(#orcid-id-f)"/></svg>
    </a>
  )}

  <!-- ResearchGate -->
  {c.researchGateUrl && (
    <a href={c.researchGateUrl} target="_blank" rel="noopener noreferrer" class="icon-btn" aria-label="ResearchGate" title="ResearchGate">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M19.586 0c-.818 0-1.508.19-2.073.565-.563.377-.97.936-1.213 1.68a3.193 3.193 0 0 0-.112.437 8.365 8.365 0 0 0-.078.53 9 9 0 0 0-.05.727L16.04 4.5l.02 1.052.05.725a8.5 8.5 0 0 0 .078.531c.029.165.066.31.112.438.243.742.65 1.302 1.213 1.678.565.376 1.255.566 2.073.566.857 0 1.638-.213 2.342-.64a4.51 4.51 0 0 0 1.66-1.736l-1.92-1.104a2.39 2.39 0 0 1-.86.92 2.27 2.27 0 0 1-1.221.317 2.42 2.42 0 0 1-.785-.12 1.61 1.61 0 0 1-.6-.36 1.717 1.717 0 0 1-.39-.575 2.797 2.797 0 0 1-.205-.79 8.3 8.3 0 0 1-.07-.99 8.3 8.3 0 0 1 .07-.99c.044-.295.115-.553.205-.79a1.7 1.7 0 0 1 .39-.575c.165-.16.365-.282.6-.36.235-.078.495-.12.785-.12.466 0 .872.107 1.221.317.349.21.636.516.86.92l1.92-1.103A4.514 4.514 0 0 0 21.928.64C21.224.214 20.444 0 19.586 0zM7.99 4.853c-2.317 0-3.96 1.5-3.96 4.135 0 2.732 1.515 4.13 3.84 4.13.79 0 1.557-.21 1.937-.553h.05v.514c0 1.5-.717 2.353-2.234 2.353-1.075 0-1.694-.42-1.85-1.107H3.205c.198 1.71 1.704 2.97 4.486 2.97 3.022 0 4.764-1.485 4.764-4.612V4.985H10.18v.685h-.05c-.38-.456-1.247-.817-2.14-.817zm.198 1.71c1.354 0 2.234.954 2.234 2.495 0 1.522-.88 2.413-2.234 2.413-1.354 0-2.234-.94-2.234-2.413 0-1.541.88-2.495 2.234-2.495z"/></svg>
    </a>
  )}

  <!-- KakaoTalk -->
  {c.kakaoUrl && (
    <a href={c.kakaoUrl} target="_blank" rel="noopener noreferrer" class="icon-btn" aria-label="KakaoTalk" title="KakaoTalk">
      <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 2031.25 1874.45" fill="currentColor"><polygon points="800.78 707.68 742.26 873.94 859.31 873.94 859.31 873.94 800.78 707.68"/><path d="M1015.62,0h0C454.71,0,0,358.53,0,800.78c0,285.93,190.1,536.82,476.05,678.49-15.56,53.65-99.97,345.16-103.33,368.06,0,0-2.02,17.21,9.12,23.77,11.14,6.56,24.25,1.46,24.25,1.46,31.95-4.46,370.54-242.29,429.14-283.59,58.54,8.29,118.83,12.6,180.39,12.6,560.92,0,1015.62-358.52,1015.62-800.78S1576.54,0,1015.62,0ZM512.7,1024.37c0,30.86-26.28,55.96-58.59,55.96s-58.59-25.1-58.59-55.96v-348.1h-91.43c-31.71,0-57.5-25.74-57.5-57.37s25.8-57.37,57.5-57.37h300.04c31.71,0,57.5,25.74,57.5,57.37s-25.8,57.37-57.5,57.37h-91.43v348.1ZM1005.14,1071.48c-11.69,5.33-24.4,8.09-37.25,8.08h0c-24.43,0-43.12-9.92-48.76-25.88l-29.01-75.96h-178.67s-29.03,76-29.03,76c-5.62,15.93-24.3,25.84-48.73,25.84-12.85.01-25.56-2.74-37.25-8.09-16.15-7.45-31.68-27.94-13.89-83.2l140.16-368.91c9.87-28.06,39.86-56.96,78.03-57.83,38.27.86,68.26,29.78,78.15,57.89l140.1,368.74c17.83,55.39,2.3,75.89-13.85,83.32ZM1301.27,1071.78h-187.99c-30.97,0-56.15-24.1-56.15-53.71v-397.95c0-32.31,26.84-58.59,59.81-58.59s59.81,26.28,59.81,58.59v344.24h124.51c30.97,0,56.15,24.1,56.15,53.71s-25.19,53.71-56.15,53.71ZM1759.95,1027.66c-2.11,15.4-10.3,29.32-22.73,38.64-10.13,7.7-22.52,11.86-35.24,11.83-18.41.09-35.77-8.55-46.81-23.29l-137.41-182.07-20.33,20.33v127.84c-.04,32.36-26.26,58.58-58.61,58.62h0c-32.31,0-58.59-26.28-58.59-58.59v-400.85c0-32.31,26.28-58.59,58.59-58.59s58.59,26.28,58.59,58.59v125.94l163.48-163.48c8.41-8.41,19.96-13.04,32.5-13.04,14.63,0,29.32,6.31,40.32,17.3,10.26,10.25,16.39,23.45,17.23,37.15.85,13.82-3.75,26.48-12.93,35.67l-133.53,133.51,144.23,191.07c9.41,12.38,13.46,28.02,11.25,43.41Z"/></svg>
    </a>
  )}

  <!-- CV download (PDF) -->
  {c.cvFullUrl && (
    <a href={c.cvFullUrl} download class="icon-btn" aria-label="Download CV (PDF)" title="Download CV (PDF)">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
        <polyline points="7 10 12 15 17 10"></polyline>
        <line x1="12" y1="15" x2="12" y2="3"></line>
      </svg>
    </a>
  )}

  <!-- Divider -->
  <span class="w-px h-5 bg-base-300 mx-1"></span>

  <!-- Theme toggle -->
  <button id="theme-toggle" class="icon-btn theme-toggle-btn" aria-label="Toggle theme" title="Toggle light / dark">
    <svg id="theme-icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
    </svg>
    <svg id="theme-icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
    </svg>
  </button>
</div>

<script is:inline>
  (function () {
    // Theme toggle
    const tToggle = document.getElementById('theme-toggle');
    const sun = document.getElementById('theme-icon-sun');
    const moon = document.getElementById('theme-icon-moon');
    function syncIcon() {
      const t = document.documentElement.getAttribute('data-theme');
      if (t === 'shlee-dark') { sun.classList.remove('hidden'); moon.classList.add('hidden'); }
      else                    { moon.classList.remove('hidden'); sun.classList.add('hidden'); }
    }
    if (tToggle) {
      syncIcon();
      tToggle.addEventListener('click', () => {
        const cur = document.documentElement.getAttribute('data-theme');
        const next = cur === 'shlee-dark' ? 'shlee-light' : 'shlee-dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('gugi516-theme', next);
        syncIcon();
      });
    }
    // Language is route-based now (/, /en) — switch handled by the <a> link, no JS needed.
  })();
</script>

<style>
  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    color: hsl(var(--bc) / 0.7);
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .icon-btn:hover {
    background-color: hsl(var(--b3));
    color: #1e3a5f;
  }
  :global(html[data-theme="shlee-dark"]) .icon-btn:hover {
    color: #6fb0e0;
  }
  .theme-toggle-btn {
    color: hsl(var(--bc) / 0.7);
  }
</style>
