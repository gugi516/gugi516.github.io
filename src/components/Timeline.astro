---
// 연표 본문 — 카테고리 × 월 매트릭스. 행 = 역할/카테고리(활성 8개), 열 = 2023-01 부터
// 빌드 시점까지 월 단위 연속 칸. 항목이 있는 칸을 그 카테고리 색으로 채운다.
// 항목은 src/data/timeline.ts 가 site.json 에서 파생한다 (여기서 데이터를 새로 만들지 않는다).
//
// 읽는 법: 한 칸 = 한 달. 칸이 채워져 있으면 그 달에 그 카테고리 실적이 있다.
// 칸 크기 = 그 달의 건수(1·2·3). 실측 최대가 3건이라 크기 3단계로 정확히 표현된다.
// 행 왼쪽 라벨이 범례를 겸하고(건수 + 이름 + 색 키), 칸을 올리면 그 칸의 모든 항목이 나온다.
//
// 빌드 타임 inline SVG 다. 차트 라이브러리를 쓰지 않는다.
//
// ⚠ 색은 아래 --tl-* CSS 토큰으로만 쓴다. daisyUI 4 의 --b1/--b2/--bc 는 **oklch 3값**
//   (`95.98% .0091 258.33`) 으로 나오므로 `hsl(var(--b2) / .5)` 는 무효값이 되어
//   fill 이 검정으로 떨어진다. 실제로 그 버그로 연도 밴드가 까맣게 보였다 (2026-11-02).
import site from "../data";
import {
  timeline, timelineByYear, monthLabel, TIMELINE_FROM,
  CAT_ORDER, type TimelineCat, type TimelineItem,
} from "../data/timeline";

// 페이지 언어는 라우트마다 고정이다 ("/" → ko, "/en" → en).
// 본문 문구는 기존처럼 KO/EN 둘 다 DOM 에 넣고 data-only 로 감추지만,
// aria-label 처럼 한 문자열만 쓸 수 있는 자리에는 이 값으로 한쪽을 고른다.
const { lang = "ko" } = Astro.props as { lang?: "ko" | "en" };
const isEn = lang === "en";
const pick = (b: { ko: string; en: string }) => (isEn ? b.en || b.ko : b.ko || b.en);

// 카테고리 라벨의 정본은 site.json timeline._catLabels (invitedTalks._typeLabels 와 같은 방식)
const catLabels =
  site.timeline._catLabels as unknown as Record<TimelineCat, { ko: string; en: string }>;

// ───────── 색: 연표 차트 전용 범주형 팔레트 ─────────
// 본문 섹션의 pill 색(파란 단색 램프)은 고유색이 5개뿐이라 8개 카테고리를 구분할 수 없었다.
// 그래서 차트 전용 팔레트를 둔다 — 본문 pill 은 건드리지 않는다.
// dataviz 스킬의 검증된 범주형 슬롯 순서를 쓰고 1번 슬롯만 사이트 브랜드 azure 로 바꿨다.
// validate_palette.js 로 라이트(surface #ffffff)·다크(surface #0c1420) 양쪽 전 항목 PASS.
// 슬롯 '순서'가 CVD 안전장치이므로 CAT_ORDER 순서 = 슬롯 순서를 깨지 않는다.
//
// book 은 9번째 색을 만들지 않는다(스킬 규칙: 9번째 계열은 생성하지 않는다).
// 논문과 같은 슬롯(2)을 쓰고 마커를 원형으로 달리해 구분한다(composite encoding).
// 현재 book 은 0건이라 화면에 나타나지 않는다.
const catSlot: Record<TimelineCat, number> = {
  position: 1, publication: 2, book: 2, invitedTalk: 3, conference: 4,
  teaching: 5, funding: 6, project: 7, patent: 8,
};
const catRound = (c: TimelineCat) => c === "book";

// ───────── 열: 2023-01 ~ 빌드 시점, 월 단위 연속 ─────────
const BUILT = new Date();
const builtYm = BUILT.getFullYear() * 12 + (BUILT.getMonth() + 1);
// 월을 아는 항목 중 가장 늦은 시점. 빌드 시점보다 미래인 실적이 들어와도 축이 잘리지 않게 한다.
const lastItemYm = timeline.reduce(
  (m, i) => (i.month >= 1 ? Math.max(m, i.year * 12 + i.month) : m), 0,
);
const endYm = Math.max(builtYm, lastItemYm);
const endYear = Math.floor((endYm - 1) / 12);
const endMonth = endYm - endYear * 12;

// 월 미상 항목이 있는 연도에만 그 해 마지막 월 칸 뒤에 '미상' 칸을 하나 넣는다.
// 월을 지어내지 않으려고 두는 칸이므로, 해당 연도가 없으면 칸도 만들지 않는다.
const unknownYears = new Set(timeline.filter((i) => i.month < 1).map((i) => i.year));

type Col = { kind: "m" | "na"; year: number; month: number };
const cols: Col[] = [];
for (let y = TIMELINE_FROM; y <= endYear; y++) {
  const to = y === endYear ? endMonth : 12;
  for (let m = 1; m <= to; m++) cols.push({ kind: "m", year: y, month: m });
  if (unknownYears.has(y)) cols.push({ kind: "na", year: y, month: 0 });
}
const colKey = (y: number, m: number) => `${y}-${m >= 1 ? m : 0}`;
const colIndex = new Map<string, number>();
cols.forEach((c, i) => colIndex.set(colKey(c.year, c.month), i));

// 연도 블록 (상단 라벨·경계선·교대 띠에 쓴다)
const blocks = Array.from(new Set(cols.map((c) => c.year))).map((year) => {
  const idx = cols.map((c, i) => (c.year === year ? i : -1)).filter((i) => i >= 0);
  return { year, from: idx[0], to: idx[idx.length - 1] };
});

// ───────── 치수 ─────────
// 데스크톱 본문 내부폭은 852px(max-w-[900px] − p-6). 아래 합이 810px 이라 가로 스크롤이 없다.
const GUT = 114;                 // 행 라벨 폭 (가장 긴 영문 "Invited talk" 기준)
const COL = 14.5;                // 한 달 칸 폭 — 좁게 잡아 전 구간이 한 화면에 들어간다
const ROW = 20;                  // 한 카테고리 행 높이
const HDR = 34;                  // 머리글 2줄(연도 + 월 눈금)
const PW = cols.length * COL;
const xAt = (i: number) => i * COL;

// 칸 마커 한 변 = 그 칸의 건수. 실측 최대 3건(= 2026 월 미상 논문 3건)이라 3단계로 충분하다.
// 4건 이상이 생기면 가장 큰 단계로 그리고 건수는 툴팁·aria 가 말한다.
const SIDE = [0, 7, 9, 10.5];
const sideOf = (n: number) => SIDE[Math.min(n, 3)];

const rows = CAT_ORDER
  .map((cat) => ({ cat, items: timeline.filter((i) => i.cat === cat) }))
  .filter((r) => r.items.length > 0)
  .map((r, ri) => ({ ...r, top: HDR + ri * ROW, mid: HDR + ri * ROW + ROW / 2 }));

const H = HDR + rows.length * ROW;

// ───────── 칸 ─────────
type Cell = {
  cat: TimelineCat;
  slot: number;
  round: boolean;
  unknown: boolean;
  x: number;        // 칸 중심
  y: number;
  side: number;
  items: TimelineItem[];
  when: { ko: string; en: string };
  aria: string;
};

const cells: Cell[] = [];
for (const row of rows) {
  const byCol = new Map<number, TimelineItem[]>();
  for (const it of row.items) {
    const ci = colIndex.get(colKey(it.year, it.month));
    if (ci === undefined) continue;          // 축 밖 — 조용히 빠진다
    if (!byCol.has(ci)) byCol.set(ci, []);
    byCol.get(ci)!.push(it);
  }
  for (const [ci, group] of byCol) {
    const sorted = [...group].sort((a, b) => a.main.en.localeCompare(b.main.en));
    const col = cols[ci];
    const unknown = col.kind === "na";
    const mon = monthLabel(col.month);
    const when = unknown
      ? { ko: `${col.year}년 · 월 미상`, en: `${col.year} · month unknown` }
      : { ko: `${col.year}년 ${mon.ko}`, en: `${mon.en} ${col.year}` };
    const cat = catLabels[row.cat] || { ko: row.cat, en: row.cat };
    const n = sorted.length;
    const countTxt = n > 1 ? (isEn ? `${n} entries` : `${n}건`) : "";
    cells.push({
      cat: row.cat,
      slot: catSlot[row.cat] || 1,
      round: catRound(row.cat),
      unknown,
      x: xAt(ci) + COL / 2,
      y: row.mid,
      side: sideOf(n),
      items: sorted,
      when,
      aria: [pick(when), pick(cat), countTxt, sorted.map((it) => pick(it.main)).join("; ")]
        .filter(Boolean).join(" · "),
    });
  }
}

const unknownItems = timeline.filter((i) => i.month < 1).length;
const placed = cells.reduce((s, c) => s + c.items.length, 0);

const chartAria = isEn
  ? `Matrix chart: ${placed} confirmed entries in ${cells.length} filled cells. Rows are categories, columns are single months from January ${TIMELINE_FROM} to the present, and a year that has entries with an unknown month ends with an "n/a" column. Cell size shows how many entries fall in that month.`
  : `매트릭스 차트: 확정 실적 ${placed}건이 ${cells.length}개 칸에 들어 있습니다. 행은 카테고리, 열은 ${TIMELINE_FROM}년 1월부터 현재까지의 월이고, 월 미상 항목이 있는 연도에는 끝에 '미상' 칸이 붙습니다. 칸 크기가 그 달의 건수입니다.`;
---

<div class="tl-chart" id="tl-chart">
  <div class="tl-chart-row">
    {/* 행 라벨 = 범례. 스크롤 영역 밖에 두어 모바일에서 표를 밀어도 항상 보인다. */}
    <svg
      class="tl-gutter" width={GUT} height={H}
      viewBox={`0 0 ${GUT} ${H}`} aria-hidden="true" focusable="false"
    >
      {rows.map((r) => {
        const lb = catLabels[r.cat] || { ko: r.cat, en: r.cat };
        return (
          <g class={`tl-c${catSlot[r.cat]}`}>
            <text class="tl-rn" x={4} y={r.mid}>{r.items.length}</text>
            <text class="tl-rl" x={GUT - 17} y={r.mid} text-anchor="end" data-only="ko">{lb.ko}</text>
            <text class="tl-rl" x={GUT - 17} y={r.mid} text-anchor="end" data-only="en">{lb.en}</text>
            {catRound(r.cat)
              ? <circle class="tl-key" cx={GUT - 8} cy={r.mid} r={3.4} fill="currentColor"></circle>
              : <rect class="tl-key" x={GUT - 11.4} y={r.mid - 3.4} width={6.8} height={6.8} rx="1.4" fill="currentColor"></rect>}
          </g>
        );
      })}
    </svg>

    <div class="tl-scroll">
      <svg
        class="tl-plot" width={PW} height={H}
        viewBox={`0 0 ${PW} ${H}`} role="group" aria-label={chartAria}
      >
        {/* 연도 교대 띠 — 아주 연한 톤만. 어두운 밴드는 쓰지 않는다. */}
        {blocks.map((b, i) => i % 2 === 1 && (
          <rect
            class="tl-zebra" x={xAt(b.from)} y={HDR}
            width={xAt(b.to + 1) - xAt(b.from)} height={H - HDR}
          ></rect>
        ))}

        {/* '미상' 열 — 달이 아니라는 뜻으로 점선 테두리를 둘러 구분한다 */}
        {cols.map((c, i) => c.kind === "na" && (
          <rect class="tl-nacol" x={xAt(i) + 0.5} y={HDR + 0.5} width={COL - 1} height={H - HDR - 1}></rect>
        ))}

        {/* 월 그리드선 (연한) */}
        {cols.map((_, i) => i > 0 && (
          <line class="tl-gl" x1={xAt(i)} x2={xAt(i)} y1={HDR} y2={H}></line>
        ))}
        {/* 행 구분선 */}
        {rows.map((r, i) => i > 0 && (
          <line class="tl-gl" x1={0} x2={PW} y1={r.top} y2={r.top}></line>
        ))}
        {/* 바깥 테두리 + 연도 경계선 */}
        <rect class="tl-frame" x={0.5} y={HDR + 0.5} width={PW - 1} height={H - HDR - 1}></rect>
        {blocks.map((b, i) => i > 0 && (
          <line class="tl-yl" x1={xAt(b.from)} x2={xAt(b.from)} y1={HDR - 15} y2={H}></line>
        ))}

        {/* 머리글 1줄 — 연도 */}
        {blocks.map((b) => (
          <text
            class="tl-yr" x={(xAt(b.from) + xAt(b.to + 1)) / 2} y={12} text-anchor="middle"
          >{b.year}</text>
        ))}
        {/* 머리글 2줄 — 분기(1·4·7·10월)에만 월 눈금. 칸이 좁아 전 월 표기는 하지 않는다. */}
        {cols.map((c, i) => c.kind === "m" && c.month % 3 === 1 && (
          <g>
            <text class="tl-mon" x={xAt(i) + COL / 2} y={HDR - 6} text-anchor="middle" data-only="ko">{c.month}</text>
            <text class="tl-mon" x={xAt(i) + COL / 2} y={HDR - 6} text-anchor="middle" data-only="en">{monthLabel(c.month).en}</text>
          </g>
        ))}

        {/* 채워진 칸 — 칸 한 변이 그 달의 건수(1·2·3) */}
        {cells.map((c, i) => (
          <g class={`tl-cell tl-c${c.slot}`} data-i={i} tabindex="0" role="img" aria-label={c.aria}>
            <rect class="tl-hit" x={c.x - COL / 2} y={c.y - ROW / 2} width={COL} height={ROW}></rect>
            {c.round ? (
              <circle
                class={`tl-mark${c.unknown ? " tl-mark-open" : ""}`}
                cx={c.x} cy={c.y} r={c.side / 2}
              ></circle>
            ) : (
              <rect
                class={`tl-mark${c.unknown ? " tl-mark-open" : ""}`}
                x={c.x - c.side / 2} y={c.y - c.side / 2}
                width={c.side} height={c.side} rx="1.8"
              ></rect>
            )}
          </g>
        ))}
      </svg>
    </div>
  </div>

  {/* 툴팁 — 내용은 아래 숨은 블록에서 복사한다 (KO/EN 둘 다 DOM 에 있고 data-only 가 한쪽을 감춘다) */}
  <div class="tl-tip" role="tooltip" hidden></div>
  <div class="tl-tipdata" hidden>
    {cells.map((c, i) => {
      const cat = catLabels[c.cat] || { ko: c.cat, en: c.cat };
      return (
        <div data-i={i}>
          <span class="tl-w">
            <span data-only="ko">{c.when.ko}</span><span data-only="en">{c.when.en}</span>
            {" · "}
            <span data-only="ko">{cat.ko}</span><span data-only="en">{cat.en}</span>
            {c.items.length > 1 && (
              <>
                {" · "}
                <span data-only="ko">{c.items.length}건</span>
                <span data-only="en">{c.items.length} entries</span>
              </>
            )}
          </span>
          {c.items.map((it) => (
            <span class="tl-e">
              <span class="tl-m">
                <span data-only="ko">{it.main.ko}</span><span data-only="en">{it.main.en}</span>
              </span>
              {(it.meta.ko || it.meta.en) && (
                <span class="tl-x">
                  <span data-only="ko">{it.meta.ko}</span><span data-only="en">{it.meta.en}</span>
                </span>
              )}
            </span>
          ))}
        </div>
      );
    })}
  </div>

  <p class="tl-note type-caption">
    <span data-only="ko">
      한 칸이 한 달입니다. 칸이 채워져 있으면 그 달에 그 행의 실적이 있고, 칸이 클수록 건수가 많습니다(1·2·3건).
      칸에 커서를 올리거나 탭하면 그 칸의 항목이 모두 나옵니다.
      {unknownItems > 0 && ` 월을 알 수 없는 ${unknownItems}건은 월을 지어내지 않고 그 해 끝의 점선 '미상' 칸에 두었습니다.`}
      <span class="tl-hint">표는 좌우로 밀어 보세요.</span>
    </span>
    <span data-only="en">
      One column = one month. A filled cell means that row had activity that month, and a bigger cell means more entries (1·2·3).
      Hover or tap a cell to list everything in it.
      {unknownItems > 0 && ` ${unknownItems} entries with an unknown month are not given an invented month — they sit in the dashed "n/a" column at the end of their year.`}
      <span class="tl-hint">Swipe the grid sideways.</span>
    </span>
  </p>

  {/* 텍스트 대안 — 차트를 못 읽는 환경(스크린리더·인쇄·색각)에서도 같은 내용을 볼 수 있게 */}
  <details class="tl-list">
    <summary>
      <span data-only="ko">목록으로 보기</span>
      <span data-only="en">View as a list</span>
    </summary>
    <div class="tl-list-body">
      {timelineByYear.map(({ year, items }) => (
        <div class="tl-list-year">
          <h3 class="year-head">{year}
            <span class="type-caption text-base-content/50 ml-2" style="font-weight:400;">
              <span data-only="ko">{items.length}건</span>
              <span data-only="en">{items.length}</span>
            </span>
          </h3>
          {items.map((it) => {
            const mon = monthLabel(it.month);
            const cat = catLabels[it.cat] || { ko: it.cat, en: it.cat };
            return (
              <div class="tl-list-row">
                <span class="tl-list-mon type-body-sm text-base-content/70">
                  <span data-only="ko">{mon.ko}</span><span data-only="en">{mon.en}</span>
                </span>
                <span class={`tl-list-cat tl-c${catSlot[it.cat]}`}>
                  <span class={`tl-list-key${catRound(it.cat) ? " tl-list-key-round" : ""}`} aria-hidden="true"></span>
                  <span data-only="ko">{cat.ko}</span><span data-only="en">{cat.en}</span>
                </span>
                <span class="tl-list-text">
                  <span class="type-body text-base-content" style="font-weight:480;">
                    <span data-only="ko">{it.main.ko}</span><span data-only="en">{it.main.en}</span>
                  </span>
                  {(it.meta.ko || it.meta.en) && (
                    <span class="tl-list-meta type-body-sm text-base-content/70">
                      <span data-only="ko">{it.meta.ko}</span><span data-only="en">{it.meta.en}</span>
                    </span>
                  )}
                </span>
              </div>
            );
          })}
        </div>
      ))}
    </div>
  </details>
</div>

<style>
  /* ── 연표 차트 전용 토큰 ──────────────────────────────────────────
     daisyUI 4 의 --b* / --bc 는 oklch 3값이라 hsl() 로 감싸면 무효값이 된다.
     그래서 이 차트는 색을 전부 아래 토큰으로 직접 둔다. 값은 tailwind.config.cjs
     의 테마색(base-100/200/300, base-content)과 같은 계열이다.
     --tl-c1..c8 = 차트 전용 범주형 팔레트 (validate_palette.js 양쪽 모드 PASS). */
  .tl-chart {
    --tl-surface:     #ffffff;
    --tl-grid:        #e4ebf3;
    --tl-grid-strong: #c4d3e3;
    --tl-zebra:       #f7fafd;
    --tl-ink:         #0f1b2a;
    --tl-ink-soft:    #5b6b80;
    --tl-ink-faint:   #93a2b5;

    --tl-c1: #2074b8;  /* 직위      — 브랜드 azure */
    --tl-c2: #eb6834;  /* 논문·저서 */
    --tl-c3: #1baf7a;  /* 초청 강연 */
    --tl-c4: #eda100;  /* 학회 발표 */
    --tl-c5: #e87ba4;  /* 강의 */
    --tl-c6: #008300;  /* 펀딩 */
    --tl-c7: #6250d6;  /* 연구 과제 */
    --tl-c8: #e34948;  /* 특허 */

    position: relative;
  }
  :global(html[data-theme="shlee-dark"]) .tl-chart {
    --tl-surface:     #0c1420;
    --tl-grid:        #1c2a3d;
    --tl-grid-strong: #2b3f59;
    --tl-zebra:       #101b28;
    --tl-ink:         #e2e6ec;
    --tl-ink-soft:    #9fb0c4;
    --tl-ink-faint:   #6d7f94;

    --tl-c1: #4a9ad8;
    --tl-c2: #d95926;
    --tl-c3: #199e70;
    --tl-c4: #c98500;
    --tl-c5: #d55181;
    --tl-c6: #008300;
    --tl-c7: #9085e9;
    --tl-c8: #e66767;
  }

  /* 색 슬롯 → currentColor. 칸·행 라벨 키·목록이 모두 이걸 상속한다. */
  .tl-c1 { color: var(--tl-c1); }
  .tl-c2 { color: var(--tl-c2); }
  .tl-c3 { color: var(--tl-c3); }
  .tl-c4 { color: var(--tl-c4); }
  .tl-c5 { color: var(--tl-c5); }
  .tl-c6 { color: var(--tl-c6); }
  .tl-c7 { color: var(--tl-c7); }
  .tl-c8 { color: var(--tl-c8); }

  /* ── 틀 ── */
  .tl-chart-row { display: flex; align-items: flex-start; }
  .tl-gutter { flex: 0 0 auto; display: block; }
  .tl-scroll {
    flex: 1 1 auto;
    min-width: 0;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }
  .tl-plot { display: block; }

  /* 행 라벨 = 범례. 글자는 색 슬롯을 입지 않는다 — 식별은 키 마커가, 읽기는 본문 잉크가 한다. */
  .tl-rl {
    font-family: var(--font-sans);
    font-size: 11.5px; font-weight: 600;
    fill: var(--tl-ink);
    dominant-baseline: middle;
  }
  .tl-rn {
    font-family: var(--font-sans);
    font-size: 9.5px; font-weight: 600;
    fill: var(--tl-ink-faint);
    font-variant-numeric: tabular-nums;
    dominant-baseline: middle;
  }

  /* ── 격자 — 연한 선만 ── */
  .tl-gl { stroke: var(--tl-grid); stroke-width: 1; }
  .tl-yl { stroke: var(--tl-grid-strong); stroke-width: 1; }
  .tl-frame { fill: none; stroke: var(--tl-grid-strong); stroke-width: 1; }
  .tl-zebra { fill: var(--tl-zebra); }
  .tl-nacol {
    fill: none;
    stroke: var(--tl-grid-strong);
    stroke-width: 1;
    stroke-dasharray: 2 2;
  }

  .tl-yr {
    font-family: var(--font-sans);
    font-size: 12px; font-weight: 680; letter-spacing: 0.03em;
    fill: var(--tl-ink-soft);
  }
  .tl-mon {
    font-family: var(--font-sans);
    font-size: 8.5px; font-weight: 600;
    fill: var(--tl-ink-faint);
  }

  /* ── 칸 ──
     히트 영역이 칸 전체라 좁은 칸도 손가락으로 집힌다.
     마커에는 바탕색 테두리를 둘러 격자선·이웃 칸과 붙어 보이지 않게 한다. */
  .tl-cell { cursor: pointer; outline: none; }
  .tl-hit { fill: transparent; }
  .tl-mark {
    fill: currentColor;
    stroke: var(--tl-surface);
    stroke-width: 1;
  }
  .tl-mark-open { fill: none; stroke: currentColor; stroke-width: 1.7; }
  .tl-cell:hover .tl-mark,
  .tl-cell.on .tl-mark { stroke: var(--tl-ink); stroke-width: 1.2; }
  .tl-cell:focus-visible .tl-hit { stroke: var(--tl-ink); stroke-width: 1.4; }

  /* ── 툴팁 ── */
  .tl-tip {
    position: absolute;
    z-index: 30;
    pointer-events: none;
    max-width: 19rem;
    padding: 7px 10px;
    border-radius: 8px;
    background: var(--tl-surface);
    border: 1px solid var(--tl-grid-strong);
    box-shadow: 0 8px 24px rgba(15, 27, 42, 0.18);
    font-size: 12px;
    line-height: 1.45;
  }
  .tl-tip[hidden] { display: none; }
  .tl-tip .tl-w {
    display: block;
    font-size: 10.5px; font-weight: 600; letter-spacing: 0.04em;
    color: var(--tl-ink-faint);
  }
  .tl-tip .tl-e { display: block; margin-top: 3px; }
  .tl-tip .tl-e + .tl-e { border-top: 1px solid var(--tl-grid); padding-top: 3px; }
  .tl-tip .tl-m { display: block; font-weight: 600; color: var(--tl-ink); }
  .tl-tip .tl-x { display: block; color: var(--tl-ink-soft); margin-top: 1px; }

  .tl-note { margin-top: 10px; line-height: 1.6; color: var(--tl-ink-faint); }
  .tl-hint { display: none; }
  @media (max-width: 940px) {
    .tl-hint { display: inline; }
  }

  /* ── 텍스트 대안 ── */
  .tl-list { margin-top: 12px; }
  .tl-list > summary {
    cursor: pointer;
    display: inline-block;
    font-size: 12px; font-weight: 600; letter-spacing: 0.02em;
    color: var(--tl-ink-soft);
    padding: 3px 0;
  }
  .tl-list > summary:hover { color: var(--tl-ink); }
  .tl-list-body { margin-top: 10px; padding-left: 14px; border-left: 2px solid var(--tl-grid-strong); }
  .tl-list-year + .tl-list-year { margin-top: 18px; }
  .tl-list-row {
    display: flex; flex-wrap: wrap; align-items: baseline;
    gap: 2px 10px;
    padding: 3px 0;
  }
  .tl-list-mon { flex: 0 0 auto; min-width: 2.6rem; }
  .tl-list-cat {
    flex: 0 0 auto;
    display: inline-flex; align-items: center; gap: 5px;
    min-width: 5.5rem;
    font-size: 11.5px; font-weight: 600;
  }
  .tl-list-cat > span[data-only] { color: var(--tl-ink-soft); }
  .tl-list-key {
    flex: 0 0 auto;
    width: 8px; height: 8px;
    border: 0; border-radius: 2px;
    background: currentColor;
  }
  .tl-list-key-round { border-radius: 9999px; }
  .tl-list-text { flex: 1 1 14rem; min-width: 0; }
  .tl-list-meta { display: block; }
</style>

<script is:inline>
  (function () {
    var wrap = document.getElementById('tl-chart');
    if (!wrap) return;
    var tip = wrap.querySelector('.tl-tip');
    var src = wrap.querySelector('.tl-tipdata');
    var scroller = wrap.querySelector('.tl-scroll');
    if (!tip || !src) return;
    var cur = null;

    function hide() {
      tip.hidden = true;
      if (cur) cur.classList.remove('on');
      cur = null;
    }

    function show(cell) {
      var node = src.querySelector('[data-i="' + cell.getAttribute('data-i') + '"]');
      if (!node) return;
      if (cur && cur !== cell) cur.classList.remove('on');
      tip.innerHTML = node.innerHTML;
      tip.hidden = false;
      tip.style.left = '0px';
      tip.style.top = '0px';
      var wr = wrap.getBoundingClientRect();
      var dr = cell.getBoundingClientRect();
      var cx = dr.left - wr.left + dr.width / 2;
      var ty = dr.top - wr.top;
      var tw = tip.offsetWidth;
      var th = tip.offsetHeight;
      var left = Math.max(2, Math.min(cx - tw / 2, wrap.clientWidth - tw - 2));
      var top = ty - th - 8;
      if (top < 0) top = ty + dr.height + 8;
      tip.style.left = left + 'px';
      tip.style.top = top + 'px';
      cell.classList.add('on');
      cur = cell;
    }

    wrap.querySelectorAll('.tl-cell').forEach(function (cell) {
      cell.addEventListener('mouseenter', function () { show(cell); });
      cell.addEventListener('mouseleave', hide);
      cell.addEventListener('focus', function () { show(cell); });
      cell.addEventListener('blur', hide);
      cell.addEventListener('click', function (e) {
        e.stopPropagation();
        if (cur === cell) hide(); else show(cell);
      });
    });

    if (scroller) scroller.addEventListener('scroll', hide, { passive: true });
    document.addEventListener('click', hide);
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') hide(); });
  })();
</script>
